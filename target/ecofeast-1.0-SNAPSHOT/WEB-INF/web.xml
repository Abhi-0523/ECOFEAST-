<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>EcoFeast - Sustainable Food Redistribution System</display-name>

    <!-- SERVLET FILTERS - RBAC Filter for Authorization -->
    <filter>
        <filter-name>RBACFilter</filter-name>
        <filter-class>com.ecofeast.filters.RBACFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>RBACFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- LOGIN SERVLET -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.ecofeast.controllers.LoginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- REGISTER SERVLET -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.ecofeast.controllers.RegisterServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- ADMIN CONTROLLER SERVLET -->
    <servlet>
        <servlet-name>AdminController</servlet-name>
        <servlet-class>com.ecofeast.controllers.AdminController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AdminController</servlet-name>
        <url-pattern>/admin/*</url-pattern>
    </servlet-mapping>

    <!-- USER CONTROLLER SERVLET -->
    <servlet>
        <servlet-name>UserController</servlet-name>
        <servlet-class>com.ecofeast.controllers.UserController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UserController</servlet-name>
        <url-pattern>/user/*</url-pattern>
    </servlet-mapping>

    <!-- LOGOUT SERVLET -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.ecofeast.controllers.LogoutServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- ERROR PAGES -->
    <error-page>
        <error-code>404</error-code>
        <location>/views/error.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/views/error.jsp</location>
    </error-page>

    <!-- SESSION CONFIGURATION -->
    <session-config>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- WELCOME FILES -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
